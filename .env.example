# Copy to .env — never commit .env (Supabase anon key + URL are public-facing but rotate if leaked)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# H1: leave unset/"false" in production. This is an internal staff console —
# public self-signup is invite-only. Set to "true" only for local/dev.
VITE_ALLOW_PUBLIC_SIGNUP="false"
